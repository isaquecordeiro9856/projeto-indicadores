# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA versione o .env (já está no .gitignore).

# Porta em que o Express sobe (padrão 3000 se omitido)
PORT=3000

# Conexão com o banco ODS (PostgreSQL, somente leitura)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Autenticação JWT
JWT_SECRET=
JWT_EXPIRATION=8h

# DEV_MODE=true faz qualquer usuário sem perfil cadastrado virar Admin
# automaticamente (bypass de auth) e também ignora a senha no login.
# NUNCA usar em produção — o app recusa subir se DEV_MODE=true com
# NODE_ENV=production.
DEV_MODE=false

# Ambiente de execução (production ativa a checagem de segurança acima)
NODE_ENV=development

# Origem(ns) permitida(s) para CORS, separadas por vírgula.
# Se omitido, libera qualquer origem (aceitável em dev, não em produção).
ALLOWED_ORIGIN=
